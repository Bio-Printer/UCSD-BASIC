' DOUBLE: 15-16 digits, functions, conversion
DEFDBL A-Z
x = 1 / 3: PRINT x
y# = 2: PRINT SQR(y#), y# ^ 0.5
PRINT 1D300 * 10, -1.5D-200 / 3
PRINT SIN(1#), COS(1#), ATN(1#) * 4
PRINT EXP(1#), LOG(10#)
s! = x: PRINT s!, CDBL(s!)
i% = 12345: PRINT i% * 1000000#
PRINT INT(-2.5#), FIX(-2.5#), CINT(2.5#), ABS(-7.25#)
PRINT 123456789012345#; .1# + .2#; VAL("3.14159265358979")
